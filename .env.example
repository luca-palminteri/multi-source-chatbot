# Copy to .env; never commit credentials. Consumed by the step 2 loader.
GOOGLE_API_KEY=
CHAT_PROVIDER=google
CHAT_MODEL=gemini-3.5-flash-lite
# Thinking level applies to Gemini 3 models; timeout is seconds per chat request.
CHAT_THINKING_LEVEL=low
CHAT_REQUEST_TIMEOUT=45
CHAT_MAX_RETRIES=0
# Shared across agent, planning, and synthesis to prevent request bursts.
CHAT_REQUESTS_PER_MINUTE=10
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
SQLITE_PATH=runtime/assistant.sqlite3
VECTOR_INDEX_PATH=runtime/vector_index
DEMO_EMPLOYEE_ID=emp-001
MCP_TRANSPORT=stdio
